<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>For You ❤️</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: linear-gradient(135deg, #ffe6e6, #ffb3b3);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
        }
        .container {
            text-align: center;
            z-index: 10;
            background: rgba(255, 255, 255, 0.85);
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            backdrop-filter: blur(5px);
        }
        h1 {
            color: #d63031;
            margin-bottom: 20px;
            font-size: 2.5rem;
        }
        p {
            color: #4d4d4d;
            font-size: 1.2rem;
            margin-bottom: 30px;
        }
        .btn {
            background-color: #ff4757;
            color: white;
            border: none;
            padding: 15px 35px;
            font-size: 1.2rem;
            font-weight: bold;
            border-radius: 50px;
            cursor: pointer;
            transition: transform 0.2s, background-color 0.2s;
            box-shadow: 0 5px 15px rgba(255, 71, 87, 0.4);
        }
        .btn:hover {
            transform: scale(1.05);
            background-color: #ff6b81;
        }
        /* Floating Hearts */
        .heart {
            position: absolute;
            font-size: 2rem;
            color: #ff4757;
            animation: float Up 4s linear forwards;
            opacity: 0;
            bottom: -50px;
        }
        @keyframes floatUp {
            0% {
                transform: translateY(0) scale(0) rotate(0deg);
                opacity: 1;
            }
            100% {
                transform: translateY(-105vh) scale(1.2) rotate(360deg);
                opacity: 0;
            }
        }
    </style>
</head>
<body>

    <div class="container">
        <h1 id="title">Hey Beautiful! ✨</h1>
        <p id="message">I just coded something special to show you how much you mean to me.</p>
        <button class="btn" id="clickBtn" onclick="revealLove()">Click Here ❤️</button>
    </div>

    <script>
        function revealLove() {
            // Change Text
            document.getElementById('title').innerText = "I Love You! 🌹";
            document.getElementById('message').innerText = "You are the best thing that ever happened to me. Thank you for making my life wonderful! Forever & Always. ❤️";
            
            // Hide Button after click
            document.getElementById('clickBtn').style.display = 'none';

            // Create Floating Hearts Loop
            setInterval(createHeart, 150);
        }

        function createHeart() {
            const heart = document.createElement('div');
            heart.classList.add('heart');
            
            // Randomly choose emoji style
            const heartTypes = ['❤️', '💖', '💝', '💕', '🌸'];
            heart.innerText = heartTypes[Math.floor(Math.random() * heartTypes.length)];
            
            // Random Position and Size
            heart.style.left = Math.random() * 100 + "vw";
            heart.style.animationDuration = Math.random() * 2 + 3 + "s"; // 3s to 5s
            
            document.body.appendChild(heart);
            
            // Remove after animation completes
            setTimeout(() => {
                heart.remove();
            }, 5000);
        }
    </script>
</body>
</html>
